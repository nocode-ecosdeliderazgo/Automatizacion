# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo para server-side (opcional)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pipeline API (opcional - para Edge Functions)
PIPELINE_API_URL=http://localhost:8000
PIPELINE_API_KEY=your-pipeline-key

# Gemini API (REQUERIDO para generacion con IA)
# Obtener en: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key

# Alternativa: usar variable publica (menos seguro pero funciona en cliente)
# NEXT_PUBLIC_GOOGLE_API_KEY=your-gemini-api-key
