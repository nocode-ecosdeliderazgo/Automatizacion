# ===========================================
# Configuracion de Entorno - GO-ESP-01
# ===========================================
# Copia este archivo a .env y completa los valores

# Google Gemini API
GOOGLE_API_KEY=your-google-api-key-here

# Configuracion del modelo
GEMINI_MODEL=gemini-2.0-flash

# Coda API (para persistencia)
CODA_API_KEY=your-coda-api-key-here
CODA_DOC_ID=your-coda-doc-id-here
CODA_TABLE_ID=your-coda-table-id-here

# Ambiente
ENVIRONMENT=development  # development | staging | production

# Logging
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json  # json | text

# Paths
CONFIG_PATH=config/step01_config.yaml
SCHEMAS_PATH=schemas/
LOGS_PATH=logs/
